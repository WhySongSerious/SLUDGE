    \uB450\uBA74 \uC6B0\uB9AC \uD130\uC804\uC774 \uC644\uC804\uD788 \uB9DD\uAC00\uC9C8
    \uAC70\uC608\uC694. \uD638\uC218 \uC8FC\uBCC0\uC758 \uBAA8\uB4E0 \uC0DD\uBB3C\uB4E4\uC774
    \uC2AC\uB77C\uC9C0\uAD70\uC758 \uC704\uD611\uC5D0 \uB5A8\uACE0 \uC788\uC5B4\uC694\u2026!\r\n\uB2F9\uC2E0\uC740
    \uC120\uD0DD\uBC1B\uC740 \uC601\uC6C5\uC774\uC5D0\uC694! \uC790\uC5F0\uC758 \uC815\uB839\uB4E4\uACFC
    \uD611\uB825\uD574 \uC2AC\uB77C\uC9C0\uAD70\uC744 \uBB34\uB108\uB728\uB9AC\uACE0,
    \uAD11\uAD50 \uD638\uC218\uACF5\uC6D0\uC744 \uC6D0\uB798\uC758 \uAE68\uB057\uD55C
    \uBAA8\uC2B5\uC73C\uB85C \uB418\uB3CC\uB824\uC8FC\uC138\uC694!"
