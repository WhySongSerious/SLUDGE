--- !u!114 &530261251
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 530261249}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5f7201a12d95ffc409449d95f23cf332, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_FontData:
    m_Font: {fileID: 10102, guid: 0000000000000000e000000000000000, type: 0}
    m_FontSize: 42
    m_FontStyle: 0
    m_BestFit: 0
    m_MinSize: 0
    m_MaxSize: 300
    m_Alignment: 0
    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 0
    m_LineSpacing: 1
  m_Text: "\uAD11\uAD50 \uD638\uC218\uACF5\uC6D0\uC740 \uD55C\uB54C \uB9D1\uACE0
    \uAE68\uB057\uD55C \uC790\uC5F0\uC758 \uC815\uC218\uC600\uC9C0\uB9CC, \uB298\uC5B4\uB09C
    \uC4F0\uB808\uAE30\uB85C \uC778\uD574 \uC624\uC5FC\uB418\uC5B4 \uC810\uC810 \uC0AC\uB78C\uB4E4\uC774
    \uB5A0\uB098\uAC8C \uB418\uC5C8\uC2B5\uB2C8\uB2E4.\n\n\uC2DC\uAC04\uC774 \uD750\uB974\uBA74\uC11C,
    \uBC84\uB824\uC9C4 \uC4F0\uB808\uAE30 \uB354\uBBF8 \uC18D\uC5D0\uC11C \"\uC2AC\uB77C\uC9C0\uAD70\"\uC774\uB77C\uB294
    \uAD34\uBB3C\uC774 \uD0C4\uC0DD\uD558\uC5EC \uACF5\uC6D0\uC744 \uC810\uB839\uD588\uC2B5\uB2C8\uB2E4.
    \n\n\uD638\uC218\uC5D0 \uC0B4\uB358 \uC0DD\uBB3C\uB4E4, \uD2B9\uD788 \uC218\uC6D0\uC758
    \uC0C1\uC9D5\uC778 \"\uC218\uC6D0 \uCCAD\uAC1C\uAD6C\uB9AC\"\uB294 \uC2AC\uB77C\uC9C0\uAD70\uC5D0
    \uB9DE\uC124 \uC218 \uC788\uB294 \uC790\uC5F0\uC758 \uD798\uC744 \uBAA8\uC544\uC904
    \uC601\uC6C5, \uC989 \uB2F9\uC2E0\uC744 \uCC3E\uAC8C \uB418\uC5C8\uC2B5\uB2C8\uB2E4.
    \n\n\uB2F9\uC2E0\uC740 \"\uD638\uC218\uACF5\uC6D0\uC758 \uC218\uD638\uC790\"\uB85C
    \uC784\uBA85\uB418\uC5C8\uACE0, \uACF5\uC6D0\uC744 \uC815\uD654\uD558\uAE30 \uC704\uD55C
    \uC5EC\uC815\uC774 \uC2DC\uC791\uB429\uB2C8\uB2E4."
